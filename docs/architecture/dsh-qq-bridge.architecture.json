  "cards": [
    {
      "dot": "cyan",
      "title": "主路径",
      "items": [
        "QQ 指令经 NapCat 转成 OneBot message event。",
        "插件只处理白名单用户且匹配 commandPrefix 的消息。",
        "默认所有有效 payload 交给 AgentRpcHandler。"
      ]
    },
    {
      "dot": "emerald",
      "title": "DSH 会话",
      "items": [
        "同一 QQ 私聊或群聊 sessionKey 复用常驻 live agent。",
        "并发消息按 sessionKey 串行，避免同一会话被同时驱动。",
        "回复从 live session 事件中提取 assistant/message 文本。"
      ]
    },
    {
      "dot": "amber",
      "title": "配置与辅助输入",
      "items": [
        "setup CLI 配置 NapCat OneBot、DSH profile 和默认权限。",
        "单号模式通过 tail NapCat 日志补齐 self-sent 消息入口。",
        "shell handler 目前是显式关闭的占位路径。"
      ]
    }
  ]
