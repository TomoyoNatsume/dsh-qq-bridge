    "zod": "^3.23.0",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "@types/ws": "^8.5.10",
    "@types/node": "^22.0.0"
  }
