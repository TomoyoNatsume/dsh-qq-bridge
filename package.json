{
  "name": "dsh-qq-bridge",
  "version": "0.1.0",
  "description": "A pluggable DSH host plugin that connects QQ (NapCat/OneBot) and forwards messages to DSH agents / local capabilities.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "dsh-qq-bridge": "dist/main.js"
  },
  "files": [
    "dist",
    "scripts/postbuild.js",
    "scripts/postinstall.js",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "postbuild": "node scripts/postbuild.js",
    "prepare": "npm run build",
    "postinstall": "node scripts/postinstall.js",
    "start": "node dist/main.js echo",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "qq",
    "napcat",
    "onebot",
    "agent"
  ],
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "ws": "^8.17.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.10",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
